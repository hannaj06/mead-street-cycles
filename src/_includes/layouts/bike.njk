---
layout: layouts/base.njk
---
<article class="bike">
    <header class="bike-hero">
        {% if hero and hero_fade %}
        <div class="hero-fade" data-hero-fade>
            <img class="hero" src="{{ hero }}" alt="{{ title }}" data-enlarge>
            <img class="hero hero-fade__next" src="{{ hero_fade }}" alt="{{ title }} alternate view" data-enlarge>
        </div>
        {% elif hero %}
        <img class="hero" src="{{ hero }}" alt="{{ title }}" data-enlarge>
        {% endif %}
        <h1>{{ title }}</h1>
        <p class="meta">
            {% if year %}{{ year }} · {% endif %}
            {% if make %}{{ make }}{% if model %} {{ model }}{% endif %}{% endif %}
            {% if tags and tags.length %} · {{ tags | join(", ") }}{% endif %}
        </p>
    </header>


{% if description %}
<div class="title">{{ description | markdown | safe }}</div>
{% endif %}


    {% if specs %}
    <section class="specs">
        <h2>Components:</h2>
        <dl>
            {% for key, value in specs %}
            <dt>{{ key }}</dt>
            <dd>{{ value }}</dd>
            {% endfor %}
        </dl>
    </section>
    {% endif %}


    {% if gallery and gallery.length %}
    <section class="gallery bike-gallery">
        {% for img in gallery %}
        <figure class="tile">
            <img src="{{ img }}" alt="{{ title }} photo {{ loop.index }}" loading="lazy" data-enlarge>
        </figure>
        {% endfor %}
    </section>
    {% endif %}

    {% if blurb %}
    <section class="blurb">
        {% if secondary_gallery and secondary_gallery.length %}
        {% set blurbParts = blurb.split('</p>') %}
        {{ blurbParts[0] | safe }}</p>
        <div class="gallery bike-gallery bike-gallery--secondary">
            {% for img in secondary_gallery %}
            <figure class="tile">
                <img src="{{ img }}" alt="{{ title }} secondary photo {{ loop.index }}" loading="lazy" data-enlarge>
            </figure>
            {% endfor %}
        </div>
        {{ blurbParts.slice(1).join('</p>') | safe }}
        {% else %}
        {{ blurb | safe }}
        {% endif %}
    </section>
    {% endif %}

    {% if closing_image %}
    <div class="bike-closing">
        <img src="{{ closing_image }}" alt="{{ title }} closing image" loading="lazy">
    </div>
    {% endif %}
</article>
